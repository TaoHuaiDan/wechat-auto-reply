+def _post_click_point(window_hwnd: int, point: tuple[int, int]) -> None:
+    """Click a listener target without moving the real cursor or activating WeChat."""
+
+    import win32con
+    import win32gui
+
+    target_hwnd = win32gui.WindowFromPoint(point)
+    if (
+        not target_hwnd
+        or not win32gui.IsWindow(target_hwnd)
+        or (target_hwnd != window_hwnd and not win32gui.IsChild(window_hwnd, target_hwnd))
+    ):
+        target_hwnd = window_hwnd
+    client_x, client_y = win32gui.ScreenToClient(target_hwnd, point)
+    lparam = ((int(client_y) & 0xFFFF) << 16) | (int(client_x) & 0xFFFF)
+    win32gui.PostMessage(target_hwnd, win32con.WM_MOUSEMOVE, 0, lparam)
+    win32gui.PostMessage(target_hwnd, win32con.WM_LBUTTONDOWN, win32con.MK_LBUTTON, lparam)
+    time.sleep(0.04)
+    win32gui.PostMessage(target_hwnd, win32con.WM_LBUTTONUP, 0, lparam)
+
+
